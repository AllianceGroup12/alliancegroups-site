{
  "functions": {
    "source": "firebase-backend/functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firebase-backend/firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase-backend/**",
      ".firebase/**",
      ".git/**",
      "node_modules/**",
      ".next/**",
      ".locust_env/**",
      ".vscode/**",
      "**/*.log",
      "**/*.py",
      "**/*.sh",
      "**/*.csv"
    ]
  }
}
